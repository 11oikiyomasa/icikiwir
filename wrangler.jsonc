{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "icikiwir",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "icikiwir-state",
      "database_id": "13351c15-56e5-474a-a595-a70146a96e67",
      "migrations_dir": "migrations"
    }
  ]
}
